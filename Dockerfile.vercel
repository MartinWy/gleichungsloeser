FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        poppler-utils \
        texlive-fonts-recommended \
        texlive-latex-extra \
        texlive-pictures \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY package.json ./
COPY . .

ENV HOST=0.0.0.0

CMD ["npm", "start"]
